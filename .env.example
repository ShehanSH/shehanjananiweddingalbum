# SQLite for local development:
DATABASE_URL="file:./dev.db"

# Neon / Vercel Postgres for production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin session signing secret (use a long random string in production)
AUTH_SECRET="replace-with-a-long-random-secret"

# Password used to sign in at /admin/login
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional: Vercel Blob for production photo storage.
# If omitted, photos are stored locally in .data/uploads (development).
BLOB_READ_WRITE_TOKEN=""
